{
  "name": "@sistema-ponto/mobile",
  "version": "1.0.8",
  "description": "App mobile para sistema de controle de ponto",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:go": "node ./scripts/start-expo-go.mjs",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^3.3.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7",
    "@react-navigation/material-top-tabs": "^7",
    "@react-navigation/native": "^7",
    "@react-navigation/native-stack": "^7",
    "@react-navigation/stack": "^7",
    "@tanstack/react-query": "^5.14.2",
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "eslint-config-expo": "~57.0.2",
    "expo": "^57.0.0",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.16",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^0.545.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.48.2",
    "react-native": "0.86.3",
    "react-native-elements": "^3.4.3",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-pager-view": "8.0.2",
    "react-native-paper": "^5.11.6",
    "react-native-permissions": "^4.1.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^3.5.2",
    "react-native-toast-message": "^2.2.0",
    "react-native-vector-icons": "^10.0.3",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/node": "^24.7.2",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "ponto",
    "frequencia",
    "react-native",
    "expo",
    "engenharia"
  ],
  "author": "Sistema Ponto Engenharia",
  "license": "MIT",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-geolocation-service",
          "react-native-vector-icons"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
