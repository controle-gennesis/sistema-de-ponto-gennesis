{
  "expo": {
    "name": "Gennesis Conecta",
    "slug": "sistema-ponto-engenharia",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.engenharia.sistemaponto",
      "infoPlist": {
        "NSCameraUsageDescription": "Este app precisa acessar a câmera para capturar fotos ao bater o ponto.",
        "NSLocationWhenInUseUsageDescription": "Este app precisa acessar sua localização para validar o ponto.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Este app precisa acessar sua localização para validar o ponto.",
        "NSFaceIDUsageDescription": "Use o Face ID para entrar no aplicativo com segurança após o primeiro acesso."
      }
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#111827"
      },
      "package": "com.engenharia.sistemaponto",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "barStyle": "dark-content",
      "translucent": true
    },
    "plugins": [
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#ce3736",
                "dark": "#ef4444"
              },
              "colorControlActivated": {
                "light": "#ce3736",
                "dark": "#ef4444"
              }
            },
            "timePicker": {
              "headerBackground": {
                "light": "#ce3736",
                "dark": "#ef4444"
              },
              "numbersSelectorColor": {
                "light": "#ce3736",
                "dark": "#ef4444"
              }
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png",
          "color": "#ce3736",
          "defaultChannel": "gennesis-activity"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use o Face ID para entrar no aplicativo com segurança após o primeiro acesso."
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/favicon.png",
          "resizeMode": "contain",
          "backgroundColor": "#111827"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "hidden": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "208f8118-e466-4554-97db-2e26271dd4fa"
      }
    },
    "owner": "lucassouzss"
  }
}
